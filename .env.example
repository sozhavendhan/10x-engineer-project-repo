# Environment — PromptLab Backend
# Copy this file to .env and fill in values before running locally or deploying.
# Never commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development        # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true            # Set to false in production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use specific domains in staging/production instead of "*".
CORS_ORIGINS=*

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
